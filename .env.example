# Copiá este archivo a .env y completá los valores
# NUNCA commitees el .env real

# Supabase: Project Settings > Database > Connection string > URI (Direct connection)
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[TU-PROJECT-REF].supabase.co:5432/postgres

# Clave secreta para JWT (generá una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esto-por-una-clave-segura
